APP_ENV=local
APP_DEBUG=true
APP_NAME=GEOFlow
SITE_NAME=GEOFlow
SITE_URL=http://localhost:18080
HOST_PORT=18080
APP_SECRET_KEY=change-this-secret
TZ=Asia/Shanghai
LOCALE=en
CRON_INTERVAL=60
DB_DRIVER=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_NAME=geo_system
DB_USER=geo_user
DB_PASSWORD=geo_password
SQLITE_PATH=storage/geoflow.sqlite
AUTO_MIGRATE=true
AUTO_SEED_ADMIN=true
DEFAULT_ADMIN_USER=admin
DEFAULT_ADMIN_PASSWORD=admin888
QUEUE_RETRY_LIMIT=3
QUEUE_BATCH_SIZE=5
AUTO_PUBLISH=false
SECURITY_HEADERS=true

